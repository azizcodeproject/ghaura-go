APP_ENV=local
HTTP_ADDR=:8080
# Railway meng-inject PORT; API memakai PORT jika ada, lalu HTTP_ADDR, lalu :8080.
DATABASE_URL=postgres://ghaura:ghaura@localhost:5432/ghaura?sslmode=disable
REDIS_ADDR=localhost:6379
# Railway Redis biasanya menyediakan REDIS_URL (redis:// atau rediss://).
# API menerima REDIS_URL dan/atau REDIS_ADDR (host:port). REDIS_URL diutamakan.
# REDIS_URL=redis://default:password@host:6379
KAFKA_BROKERS=localhost:19092
NEXT_PUBLIC_API_URL=http://localhost:8080

# Deploy Railway: lihat docs/railway.md (bukan docker-compose sebagai satu unit).
